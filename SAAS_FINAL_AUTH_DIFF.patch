+  if (user.role === 'platform_admin' || user.role === 'master_admin') {
+    return 'PLATFORM';
+  }
+  if (user.role === 'admin') {
+    return 'TENANT';
+  }
+  if (user.role === 'team_lead') {
+    return 'TEAM';
+  }
+  return 'OWN';
+}
