+export async function isTeamLeader(userId: string, teamId: string, tenantId: string): Promise<boolean> {
+  const team = await db.queryOne<{ leaderId: string }>(`
+    SELECT "leaderId" FROM teams WHERE id = $1 AND "tenantId" = $2
+  `, [teamId, tenantId]);
