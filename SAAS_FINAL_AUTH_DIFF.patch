+  const member = await db.queryOne<{ roleInTeam: string }>(`
+    SELECT "roleInTeam" FROM team_members WHERE "teamId" = $1 AND "userId" = $2 AND "tenantId" = $3
+  `, [teamId, userId, tenantId]);
