{
  "name": "octal-dialer-backend",
  "version": "1.0.0",
  "description": "Backend Socket.IO server for Octal Dialer",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/db/migrations', {recursive:true}); fs.copyFileSync('src/db/schema.sql', 'dist/db/schema.sql'); for(const f of fs.readdirSync('src/db/migrations')) fs.copyFileSync('src/db/migrations/'+f, 'dist/db/migrations/'+f);\"",
    "start": "node dist/server.js",
    "test:security": "node tests/security_regressions.cjs",
    "test:scraper": "node tests/scraper_hardening_tests.cjs",
    "test:integration": "node tests/scraper_integration_tests.cjs",
    "profile:scraper": "node tests/profile_scraper_processes.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
