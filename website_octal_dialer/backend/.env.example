# ─────────────────────────────────────────────────────────────────────────────
# Octal Dialer backend environment
#
# Copy to .env and fill in. Values marked REQUIRED IN PRODUCTION cause a
# fail-fast error at startup when NODE_ENV=production and they are missing.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# ── Secrets ──────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Minimum 32 characters.
JWT_SECRET=
BILLING_WEBHOOK_SECRET=

# REQUIRED IN PRODUCTION. Minimum 32 characters.
# Key for the credential vault (AES-256-GCM at rest) that protects mailbox
# passwords, OAuth refresh/access tokens, and Facebook session cookie jars.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WARNING: rotating this key makes every previously sealed credential
# unreadable. Re-enter mailbox passwords and re-link Facebook sessions after a
# rotation. In development the key is derived from JWT_SECRET automatically.
SECRETS_KEY=

# Bootstrap accounts created on first boot (admin / owner). Minimum 12 chars.
# If unset in production a random password is generated and printed ONCE at
# creation — capture it from the logs and change it immediately.
# Existing accounts are never re-passworded on restart.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_OWNER_PASSWORD=

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=
DB_PATH=

# ── Networking ───────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TRUST_PROXY=false
PUBLIC_APP_URL=https://zestify7.online
SESSION_TTL_HOURS=24

# ── OAuth providers (mailbox linking) ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# ── Cloudflare Turnstile / CAPTCHA ───────────────────────────────────────────
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# ── Transactional email (system notifications, OTP) ──────────────────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@octaldialer.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
